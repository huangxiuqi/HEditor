{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.toolchain/ninja/ninja.exe"
      }
    },
    {
      "name": "native",
      "displayName": "原生 Release（验证宿主）",
      "description": "MSVC + Ninja。shell 里先 . scripts/msvc_env.ps1（它现找 VS 与 SDK 并摆好 INCLUDE / LIB / Path，等价 vcvars64），x64 版 Skia 静态库由 scripts/build_skia_native.ps1 出。",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-debug",
      "displayName": "原生 Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly（Emscripten + Skia）",
      "description": "交付物。工具链取仓库内的 .toolchain/emsdk，见 docs/依赖与工具链管理.md。",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "${sourceDir}/.toolchain/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "environment": {
        "EM_CONFIG": "${sourceDir}/.toolchain/emsdk/.emscripten",
        "PATH": "${sourceDir}/.toolchain/emsdk/upstream/emscripten;${sourceDir}/.toolchain/emsdk;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly（调试档：断言 + 栈检查 + 源码映射）",
      "description": "与 wasm 同一套产物，只是多带调试信息：trap 时能给出可读的 C++ 栈与源码位置。",
      "inherits": "wasm",
      "binaryDir": "${sourceDir}/build/wasm-debug",
      "cacheVariables": {
        "HEDITOR_WASM_DEBUG": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "wasm", "configurePreset": "wasm" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug" }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "displayName": "功能判据：四片并行",
      "output": { "verbosity": "verbose", "outputOnFailure": true },
      "execution": { "jobs": 4, "noTestsAction": "error" },
      "filter": { "include": { "label": "functional" } }
    },
    {
      "name": "native-perf",
      "configurePreset": "native",
      "displayName": "耗时比值判据：独占跑（改完排版或光栅再跑）",
      "output": { "verbosity": "verbose", "outputOnFailure": true },
      "execution": { "jobs": 1, "noTestsAction": "error" },
      "filter": { "include": { "label": "perf" } }
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "displayName": "功能判据：四片并行",
      "output": { "verbosity": "verbose", "outputOnFailure": true },
      "execution": { "jobs": 4, "noTestsAction": "error" },
      "filter": { "include": { "label": "functional" } }
    }
  ],
  "workflowPresets": [
    {
      "name": "native",
      "displayName": "配置 + 构建 + 跑功能判据（四片并行）",
      "steps": [
        { "type": "configure", "name": "native" },
        { "type": "build", "name": "native" },
        { "type": "test", "name": "native" }
      ]
    },
    {
      "name": "wasm",
      "displayName": "配置 + 构建 wasm 产物",
      "steps": [
        { "type": "configure", "name": "wasm" },
        { "type": "build", "name": "wasm" }
      ]
    },
    {
      "name": "wasm-debug",
      "displayName": "配置 + 构建 wasm 调试档（断言 + 栈检查 + 源码映射）",
      "steps": [
        { "type": "configure", "name": "wasm-debug" },
        { "type": "build", "name": "wasm-debug" }
      ]
    }
  ]
}
