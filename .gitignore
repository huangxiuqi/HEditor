# ─────────────────────────────────────────────────────────────
#  构建产物
# ─────────────────────────────────────────────────────────────
# build/ 下是 native 与 wasm 两套构建目录（含 ced_editor.js / ced_editor.wasm）。
# ★ 两套都能由 scripts/build_native.ps1 与 scripts/build_wasm.ps1 重建，
#   入库只会让每次 diff 都夹着几 MB 二进制。
build/

# 验证产物：探针 JSON、截图、日志、_scratch。全部可以重跑探针再生成。
out/

# 验证台前端的"打包输出"（目前没用到，留着给将来）
web/dist/

# ─────────────────────────────────────────────────────────────
#  工具链（自包含，不入库）
# ─────────────────────────────────────────────────────────────
# .toolchain/ 里有 emsdk（含 LLVM/node/python）、Skia 源码与 gn/ninja。
# ★ Skia 源码约 79.9 MB，emsdk 更大 —— 重建命令：scripts/build_skia_wasm.ps1
.toolchain/

# ─────────────────────────────────────────────────────────────
#  第三方源码：体积大，按需拉取
# ─────────────────────────────────────────────────────────────
# CMake 会检查 third_party/harfbuzz-14.6.0 是否存在，不在就提示"请先 fetch_deps"
# —— 也就是说这些源码本来就**不打算**入库。
third_party/*.tar.xz
third_party/harfbuzz-*/
third_party/freetype-*/

# 下载残留（字体正式位置是 assets/fonts/，这里是当时抓下来的原件）
third_party/*.ttf

# ─────────────────────────────────────────────────────────────
#  本机验证产物
# ─────────────────────────────────────────────────────────────
# 探针/单测的截图与中间图。★ 这些是"证据"不是"素材"：
#   要证据就重跑一次探针 —— 它每一步都带可证伪断言，比一张静态图片可信。
*.png
*.ppm
*.log

# ─────────────────────────────────────────────────────────────
#  编辑器 / 系统噪声
# ─────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo
*~
Thumbs.db
.DS_Store

# ─────────────────────────────────────────────────────────────
#  工具缓存
# ─────────────────────────────────────────────────────────────
.cache/
.clangd/
compile_commands.json
.ninja_log
.ninja_deps

# 兜底的二进制（真正的构建产物都在 build/ 下，这条只是防手滑）
*.exe
*.dll
*.pdb

# ─────────────────────────────────────────────────────────────
#  语言侧噪声（scripts 里偶尔会临时用到）
# ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
node_modules/
.workbuddy

# ─────────────────────────────────────────────────────────────
#  ★ 下面这些是**要入库**的 —— 列在这里是为了防止将来顺手加规则把它们排掉：
#      assets/fonts/*.ttf     运行期必需的字体（合计 19.7 MB，其中 SC-VF 17.7 MB）
#                             —— 引擎与页面直接读它，不入库就跑不起来
#      licenses/              Skia / FreeType 的许可原文（有致谢义务，必须随源码走）
#      docs/THIRD_PARTY_NOTICES.md
#      .workbuddy/memory/     本项目的工作日志（跨会话的项目知识）
#      web/*.html  web/*.js   验证台前端源码（不是构建产物）
# ─────────────────────────────────────────────────────────────
